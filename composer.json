{
    "name": "vzgcoders/discordphp-bridge-twitch",
    "description": "The Twitch connector for DiscordPHP-Bridge: a two-way chat bridge, the whole Helix API, and one command catalogue shared with every other network the bot is on.",
    "keywords": [
        "discord",
        "twitch",
        "helix",
        "chat",
        "relay",
        "bridge",
        "bot",
        "reactphp",
        "async",
        "connector"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Valithor Obsidion",
            "email": "valithor@valgorithms.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "discord-php/bridge": "@dev",
        "react/event-loop": "^1.5",
        "react/promise": "^3.2",
        "vzgcoders/twitchphp": "@dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpunit/phpunit": "^11.0 || ^10.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../DiscordPHP-Bridge",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../TwitchPHP",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../TwitchPHP-Http",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Bridge\\Twitch\\": "src/Bridge/Twitch/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bridge\\Twitch\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
