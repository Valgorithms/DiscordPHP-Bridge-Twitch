# Copy to .env and fill in. Never commit the result.

# ── Discord ────────────────────────────────────────────────────────────
# Use a DEDICATED application. Message commands are matched by prefix rather
# than registered with Discord, so two bots sharing a token and a prefix will
# both answer the same message.
DISCORD_TOKEN=

# Enable the MESSAGE CONTENT intent on the application page, or every relayed
# message arrives empty and no command is ever recognised.

# ── Twitch ─────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=

# Optional. Without it the bot runs and relays, but cannot REFRESH its access
# token: `OAuth::form()` refuses every grant except device-code when no secret
# is set. Roughly four hours in, it will ask for a device code instead — see
# DISCORD_OWNER_ID below. Set a secret for unattended operation.
TWITCH_CLIENT_SECRET=

# The account the bot speaks as in Twitch chat.
TWITCH_NICK=

# A user token for that account, and its refresh token. The bot rewrites both
# here when Twitch rotates them — Twitch invalidates the old refresh token on
# every rotation, so anything that does not persist the new pair locks itself
# out on the next restart. For the same reason, do not share one pair with
# another project: whichever refreshes first breaks the other's copy.
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# ── Who may run `api` ──────────────────────────────────────────────────
# `api` reaches every Helix endpoint with the bot's own token — it can ban
# users, end streams and rewrite a channel. It is gated to these two identities
# and nobody else, not even the broadcaster. With neither set, `api` is
# unreachable from both chats, which is the intended default.
DISCORD_OWNER_ID=
TWITCH_OWNER_LOGIN=

# DISCORD_OWNER_ID is also where the device-code prompt is DM'd when the token
# needs re-authorizing. Without it that prompt only reaches the log.

# ── Optional ───────────────────────────────────────────────────────────
# Command prefixes, per surface. Separate because another bot may already own
# `!` in one of the two chats.
DISCORD_PREFIX=!
TWITCH_PREFIX=!

# debug | info | notice | warning | error
LOG_LEVEL=info
